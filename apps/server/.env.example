# Copy to .env for local development.
DATABASE_URL="postgresql://aruna:aruna@localhost:5432/aruna_pos?schema=public"
PORT=3000
HOST=0.0.0.0
# "shop" runs billing and stock; "cloud" is the online panel for Admins and the Super Admin,
# kept in step with the shop by two-way sync.
APP_MODE=shop
# Cloud only: the key shop servers sync with (the same text goes in the shop's Settings → Cloud
# mirror "Shop key"). The cloud must also use the shop's PIN_SECRET.
# SYNC_KEY="a-long-random-string"
# Secret used to hash PINs (HMAC). Keep it with the server; losing it means resetting PINs.
PIN_SECRET="change-me-to-a-long-random-string"
# Where backups, receipts written by the "file" printer driver and logs go.
DATA_DIR=./data
# PostgreSQL's bin folder (pg_dump, pg_restore) for backups and test mode. Leave it out to look in
# PATH and the usual install folders; set it if they live elsewhere.
# PG_BIN_DIR="C:/Program Files/PostgreSQL/16/bin"
# Cloud only, when DATABASE_URL is a pooled address: a direct one for making shop databases and
# migrations (Neon on Vercel gives DATABASE_URL_UNPOOLED, which is read by itself).
# DIRECT_DATABASE_URL="postgresql://..."
