{
  "name": "@aruna/server",
  "version": "1.0.8",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/index.ts",
    "start": "node --env-file-if-exists=.env dist/index.js",
    "build": "prisma generate && tsup",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:reset": "prisma migrate reset --force",
    "db:clean": "tsx --env-file-if-exists=.env src/scripts/clean-dummy.ts",
    "db:seed": "tsx --env-file-if-exists=.env src/scripts/seed.ts",
    "db:generate": "prisma generate"
  },
  "prisma": {
    "seed": "tsx src/scripts/seed.ts"
  },
  "dependencies": {
    "@aruna/shared": "workspace:*",
    "@fastify/cookie": "11.1.5",
    "@fastify/static": "10.1.10",
    "@fastify/websocket": "11.3.7",
    "@prisma/client": "6.19.3",
    "fastify": "5.12.8",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "22.18.12",
    "prisma": "6.19.3",
    "tsup": "8.5.0",
    "tsx": "4.20.6",
    "vitest": "3.2.4"
  }
}
